ADMIN_USERNAME=admin
ADMIN_PASSWORD=maus-admin
SESSION_SECRET=replace-with-a-long-random-string

# Leave empty for a local SQLite file at data/maus.db.
# On Vercel, create a Turso database and paste both values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Leave empty to save admin uploads in public/uploads.
# On Vercel, connect a Blob store so this token is set automatically.
BLOB_READ_WRITE_TOKEN=
